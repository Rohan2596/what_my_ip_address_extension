{
  "manifest_version": 3,
  "name": "What Is My IP address On Chrome",
  "description": "Shows your public IPv4 and IPv6 address, plus location, ISP and timezone, in one click.",
  "version": "1.1",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ipapi.co/json/",
    "https://ipinfo.io/json"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
